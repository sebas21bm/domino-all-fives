<UserControl x:Class="DominoAllFives.Client.WPF.Controls.ResolvePlayerReport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DominoAllFives.Client.WPF.Controls"
             xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization;assembly=DominoAllFives.Client.WPF"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Style="{StaticResource RoundedPanelStyle}"
            Width="850"
            Padding="45,35">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Título: DECISIÓN -->
            <TextBlock Grid.Row="0"
                       Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblDecision]}"
                       Style="{StaticResource SectionTitleText}"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

            <!-- 2. Tres Botones de Decisión: NO HACER NADA / BANEAR JUGADOR / SUSPENSIÓN -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- Botón: NO HACER NADA -->
                <Button x:Name="btnDoNothing"
                        Grid.Column="0"
                        MinHeight="54"
                        Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[ResolvePlayerReport_btnDoNothing]}"
                        Command="{Binding SelectDoNothingCommand}"
                        FontSize="11">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDoNothingSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryRedBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource DarkRedBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource CreamLightBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Botón: BANEAR JUGADOR -->
                <Button x:Name="btnBan"
                        Grid.Column="2"
                        MinHeight="54"
                        Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[ResolvePlayerReport_btnBan]}"
                        Command="{Binding SelectBanCommand}"
                        FontSize="11">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBanSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryRedBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource DarkRedBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource CreamLightBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Botón: SUSPENSIÓN -->
                <Button x:Name="btnSuspend"
                        Grid.Column="4"
                        MinHeight="54"
                        Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[ResolvePlayerReport_btnSuspend]}"
                        Command="{Binding SelectSuspendCommand}"
                        FontSize="11">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSuspensionSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryRedBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource DarkRedBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource CreamLightBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </Grid>

            <!-- 3. Sub-sección de Días de Suspensión (Ubicado justo debajo de los botones a la derecha) -->
            <Grid Grid.Row="2" HorizontalAlignment="Right" Margin="0,0,30,20">

                <StackPanel Orientation="Horizontal"
                            IsEnabled="{Binding IsSuspensionSelected}">

                    <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[ResolvePlayerReport_lblDays]}"
                               Style="{StaticResource FieldLabelText}"
                               FontSize="15"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <TextBox x:Name="txtSuspensionDays"
                             Width="75" Height="42"
                             Style="{StaticResource CreamTextBox}"
                             Text="{Binding SuspensionDays, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"/>

                </StackPanel>

            </Grid>

            <!-- 4. Etiqueta: MOTIVO: -->
            <TextBlock Grid.Row="3"
                       Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblReason]}"
                       Style="{StaticResource FieldLabelText}"
                       FontSize="15"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,12"/>

            <!-- 5. Campo de Texto: Motivo de la resolución -->
            <TextBox x:Name="txtReason"
                     Grid.Row="4"
                     MinHeight="120"
                     Margin="0,0,0,35"
                     Style="{StaticResource CreamTextBox}"
                     Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     Padding="15,12"
                     FontSize="13"/>

            <!-- 6. Botones de Acción: ENVIAR y REGRESAR -->
            <Grid Grid.Row="5" HorizontalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnSend"
                        Grid.Column="0"
                        Style="{StaticResource PrimaryButton}"
                        MinHeight="52"
                        Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnSend]}"
                        Command="{Binding SendResolutionCommand}"/>

                <Button x:Name="btnBack"
                        Grid.Column="2"
                        Style="{StaticResource OutlineButton}"
                        MinHeight="52"
                        Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnBack]}"
                        Command="{Binding BackCommand}"/>

            </Grid>

        </Grid>

    </Border>
</UserControl>
