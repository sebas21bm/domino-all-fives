<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
  <connectionStrings configSource="Configuration\DatabaseConnection.config" />
  <entityFramework><providers><provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" /></providers></entityFramework>
	
	<system.serviceModel>
		<bindings>
			<netTcpBinding>
				<binding name="DominoTcp">
					<security mode="None" />
				</binding>
				<binding name="LobbyTcp">
					<security mode="None" />
				</binding>
			</netTcpBinding>
		</bindings>

		<behaviors>
			<serviceBehaviors>
				<behavior name="DominoBehavior">
					<serviceMetadata httpGetEnabled="true" />
					<serviceDebug includeExceptionDetailInFaults="false" />
				</behavior>
			</serviceBehaviors>
		</behaviors>

		<services>
			<service
			  name="DominoAllFives.Server.DominoService"
			  behaviorConfiguration="DominoBehavior">

				<host>
					<baseAddresses>
						<add
						  baseAddress="net.tcp://localhost:8733/Domino" />
						<add
						  baseAddress="http://localhost:8734/Domino/" />
					</baseAddresses>
				</host>

				<endpoint
				  address="mex"
				  binding="mexHttpBinding"
				  contract="IMetadataExchange" />

				<endpoint
				  address="account"
				  binding="netTcpBinding"
				  bindingConfiguration="DominoTcp"
				  contract="DominoAllFives.Contracts.Services.ISessionAccount" />

				<endpoint
				  address="ranking"
				  binding="netTcpBinding"
				  bindingConfiguration="DominoTcp"
				  contract="DominoAllFives.Contracts.Services.IRankingService" />
			</service>

			
			<service
			  name="DominoAllFives.Server.LobbyService"
			  behaviorConfiguration="DominoBehavior">

				<host>
					<baseAddresses>
						<add
						  baseAddress="net.tcp://localhost:8735/Lobby" />

						<add
						  baseAddress="http://localhost:8736/Lobby/" />
					</baseAddresses>
				</host>

				<endpoint
				  address="mex"
				  binding="mexHttpBinding"
				  contract="IMetadataExchange" />

				<endpoint
				  address=""
				  binding="netTcpBinding"
				  bindingConfiguration="LobbyTcp"
				  contract="DominoAllFives.Contracts.Services.ILobbyService" />
			</service>

		</services>
	</system.serviceModel>
	
</configuration>
