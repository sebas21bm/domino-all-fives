<Page x:Class="DominoAllFives.Client.WPF.Views.Reports"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DominoAllFives.Client.WPF.Views"
      xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization"
      mc:Ignorable="d"
      Title="Domino All Fives"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Background="{StaticResource DarkBgBrush}">

        <Viewbox Stretch="Uniform">

            <Grid Width="1600" Height="900"
                  Background="{StaticResource DarkBgBrush}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="822"/>
                </Grid.RowDefinitions>

                <!-- Header Superior -->
                <Border Grid.Row="0" Style="{StaticResource HeaderBarStyle}">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnBack"
                                Grid.Column="0"
                                Margin="10,7,0,7"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource BackButton}"
                                ToolTip="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnBack]}"
                                Command="{Binding GoBackCommand}"/>

                        <Image Grid.Column="2"
                               Source="../Assets/Images/logoShort.png"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource ShortLogoStyle}"/>

                    </Grid>

                </Border>

                <!-- Cuerpo Principal -->
                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="520"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Columna Izquierda: Título y Navegación de Pestañas -->
                    <Grid Grid.Column="0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="110"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Margin="65,35,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Reports_lblTitle]}"
                                   Style="{StaticResource PageTitleText}"/>

                        <StackPanel Grid.Row="1"
                                    Margin="72,50,30,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">

                            <!-- Pestaña Jugadores -->
                            <Button x:Name="btnPlayerReports"
                                    MinWidth="270"
                                    MinHeight="62"
                                    Margin="0,0,0,55"
                                    Padding="18,12"
                                    Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblPlayers], Mode=OneWay}"
                                    Command="{Binding ShowPlayerReportsCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavigationTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlayerReportsVisible}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryRedBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource DarkRedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Pestaña Partidas -->
                            <Button x:Name="btnMatchReports"
                                    MinWidth="270"
                                    MinHeight="62"
                                    Padding="18,12"
                                    Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Reports_btnMatches], Mode=OneWay}"
                                    Command="{Binding ShowMatchReportsCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavigationTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMatchReportsVisible}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryRedBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource DarkRedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                        </StackPanel>

                    </Grid>

                    <!-- Divisor Vertical -->
                    <Border Grid.Column="1"
                            Margin="0,50,0,55"
                            Style="{StaticResource VerticalDividerStyle}"/>

                    <!-- Columna Derecha: Contenido de Listados -->
                    <Grid Grid.Column="2">

                        <!-- Sección 1: Reportes de JUGADORES -->
                        <Grid x:Name="grdPlayerReports"
                              Margin="55,65,85,40"
                              Visibility="{Binding IsPlayerReportsVisible, Converter={StaticResource BoolToVis}}">

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">

                                <ListBox x:Name="lstPlayerReports"
                                         ItemsSource="{Binding PlayerReports}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">

                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,25"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>

                                            <Grid Width="920">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="85"/>
                                                    <ColumnDefinition Width="580"/>
                                                    <ColumnDefinition Width="35"/>
                                                    <ColumnDefinition Width="220"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Avatar del Jugador -->
                                                <Grid Grid.Column="0"
                                                      Width="68"
                                                      Height="68"
                                                      HorizontalAlignment="Left">

                                                    <Ellipse Style="{StaticResource SmallAvatarBorderStyle}"/>

                                                    <Image Source="{Binding AvatarSource}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource SmallAvatarImageStyle}">
                                                        <Image.Clip>
                                                            <EllipseGeometry Center="31,31"
                                                                             RadiusX="31"
                                                                             RadiusY="31"/>
                                                        </Image.Clip>
                                                    </Image>

                                                </Grid>

                                                <!-- Nombre del Jugador -->
                                                <Border Grid.Column="1"
                                                        MinHeight="64"
                                                        Style="{StaticResource OutlinedListItemStyle}">

                                                    <TextBlock Text="{Binding Username}"
                                                               Style="{StaticResource TextCream}"
                                                               FontSize="13"
                                                               TextAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Stretch"
                                                               VerticalAlignment="Center"/>

                                                </Border>

                                                <!-- Botón Ver Reporte -->
                                                <Button Grid.Column="3"
                                                        MinWidth="200"
                                                        MinHeight="64"
                                                        Padding="16,10"
                                                        Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Reports_btnViewReport]}"
                                                        Command="{Binding DataContext.ViewPlayerReportCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        FontSize="12"/>

                                            </Grid>

                                        </DataTemplate>
                                    </ListBox.ItemTemplate>

                                </ListBox>

                            </ScrollViewer>

                        </Grid>

                        <!-- Sección 2: Reportes de PARTIDAS -->
                        <Grid x:Name="grdMatchReports"
                              Margin="55,65,85,40"
                              Visibility="{Binding IsMatchReportsVisible, Converter={StaticResource BoolToVis}}">

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">

                                <ListBox x:Name="lstMatchReports"
                                         ItemsSource="{Binding MatchReports}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">

                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,25"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>

                                            <Grid Width="920">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="665"/>
                                                    <ColumnDefinition Width="35"/>
                                                    <ColumnDefinition Width="220"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Info Concatenada de la Partida (Partida #X - Fecha: DD/MM/YYYY) -->
                                                <Border Grid.Column="0"
                                                        MinHeight="64"
                                                        Style="{StaticResource OutlinedListItemStyle}">

                                                    <TextBlock Text="{Binding DisplayText}"
                                                               Style="{StaticResource TextCream}"
                                                               FontSize="13"
                                                               TextAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Stretch"
                                                               VerticalAlignment="Center"/>

                                                </Border>

                                                <!-- Botón Ver Reporte -->
                                                <Button Grid.Column="2"
                                                        MinWidth="200"
                                                        MinHeight="64"
                                                        Padding="16,10"
                                                        Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Reports_btnViewReport]}"
                                                        Command="{Binding DataContext.ViewMatchReportCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        FontSize="12"/>

                                            </Grid>

                                        </DataTemplate>
                                    </ListBox.ItemTemplate>

                                </ListBox>

                            </ScrollViewer>

                        </Grid>

                    </Grid>

                </Grid>

            </Grid>

        </Viewbox>

    </Grid>
</Page>
