<Page x:Class="DominoAllFives.Client.WPF.Views.EditProfile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DominoAllFives.Client.WPF.Views"
      xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1600"
      Title="Edit Profile"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Grid Background="{StaticResource DarkBgBrush}">
        <Viewbox Stretch="Uniform">
            <Grid Width="1600" Height="900" Background="{StaticResource DarkBgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource HeaderBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnBack"
                                Grid.Column="0"
                                Margin="10,7,0,7"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource BackButton}"
                                ToolTip="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnBack]}"
                                Command="{Binding GoBackCommand}"/>

                        <Image Grid.Column="2"
                               Source="../Assets/Images/logoShort.png"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource ShortLogoStyle}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[EditProfile_lblTitle]}" 
                               Style="{StaticResource PageTitleText}" 
                               FontSize="48"
                               Foreground="{StaticResource CreamLightBrush}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Margin="100,50,0,0"/>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0">

                        <Grid Width="350" Height="350" Margin="0,0,0,40">
                            <Ellipse Width="240" Height="50"
                                     VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-10"
                                     Fill="{StaticResource DarkRedBrush}"
                                     Opacity="0.65">
                                
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#CC2222"
                                        BlurRadius="120"
                                        ShadowDepth="0"
                                        Opacity="0.90"/>
                                </Ellipse.Effect>

                            </Ellipse>

                        <Grid Width="320"
                                Height="320"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                            <Ellipse Fill="{StaticResource DarkBgBrush}"/>

                            <Image x:Name="imgProfileAvatar"
                                    Width="302"
                                    Height="302"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Stretch="UniformToFill"
                                    Source="{Binding ProfilePicture}">

                                <Image.Clip>
                                    <EllipseGeometry Center="151,151"
                                                        RadiusX="151"
                                                        RadiusY="151"/>
                                </Image.Clip>

                            </Image>

                            <Ellipse Fill="Transparent"
                                        Stroke="{StaticResource CreamLightBrush}"
                                        StrokeThickness="8"
                                        IsHitTestVisible="False"/>

                        </Grid>

                            <Button x:Name="btnChangePicture" 
                                    Command="{Binding ChangePictureCommand}"
                                    Width="60" Height="60" 
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,30,20"
                                    Cursor="Hand"
                                    ToolTip="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[EditProfile_btnChangePicture]}">
                                
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Image Source="../Assets/Icons/iconEdit.png"
                                               Style="{StaticResource EditIconStyle}"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <TextBox x:Name="txtUsername" 
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource CreamTextBox}"
                                 MaxLength="64"
                                 Width="500" Height="65"
                                 FontSize="28"
                                 HorizontalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,0,60"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="btnSave" 
                                    Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnSave]}" 
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveCommand}" 
                                    Width="260" Height="65" Margin="0,0,30,0"
                                    FontSize="15"/>

                            <Button x:Name="btnDiscard" 
                                    Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnDiscard]}" 
                                    Style="{StaticResource DarkButton}" 
                                    Command="{Binding DiscardCommand}" 
                                    Width="360" Height="65"
                                    FontSize="15"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Page>
