<Page x:Class="DominoAllFives.Client.WPF.Views.MatchHistory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1600"
      Title="Match History"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Grid Background="{StaticResource DarkBgBrush}">
        <Viewbox Stretch="Uniform">
            <Grid Width="1600" Height="900" Background="{StaticResource DarkBgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource HeaderBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnBack"
                                Grid.Column="0"
                                Margin="10,7,0,7"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource BackButton}"
                                ToolTip="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnBack]}"
                                Command="{Binding GoBackCommand}"/>

                        <Image Grid.Column="2"
                               Source="../Assets/Images/logoShort.png"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource ShortLogoStyle}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="120,40,120,40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[MatchHistory_lblTitle]}" 
                               Style="{StaticResource PageTitleText}" 
                               FontSize="36"
                               Foreground="{StaticResource CreamLightBrush}"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,30"/>

                    <Border Grid.Row="1" BorderBrush="{StaticResource CreamLightBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="480"/>
                                <ColumnDefinition Width="400"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblDate]}" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryRedBrush}" FontSize="20" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblPlayers]}" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryRedBrush}" FontSize="20" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="2" Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblFinalScores]}" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryRedBrush}" FontSize="20" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="3" Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblWinner]}" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryRedBrush}" FontSize="20" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="itmMatchHistory" ItemsSource="{Binding MatchHistoryList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource CreamLightBrush}" BorderThickness="0,0,0,1" Padding="0,22,0,22" Opacity="0.9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="300"/>
                                                <ColumnDefinition Width="480"/>
                                                <ColumnDefinition Width="400"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding MatchDate}" VerticalAlignment="Center" FontSize="22" Foreground="{StaticResource CreamLightBrush}" HorizontalAlignment="Left"/>

                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Participants}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="20" Foreground="{StaticResource CreamLightBrush}" Margin="0,3,0,3"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ItemsControl Grid.Column="2" ItemsSource="{Binding FinalScores}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="20" Foreground="{StaticResource CreamLightBrush}" Margin="0,3,0,3"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Grid.Column="3" Text="{Binding WinnerName}" VerticalAlignment="Center" FontSize="24" Foreground="{StaticResource CreamLightBrush}" FontWeight="Bold" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Page>
