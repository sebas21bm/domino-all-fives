<UserControl x:Class="DominoAllFives.Client.WPF.Controls.ReportInfoResults"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization"
             mc:Ignorable="d"
             Background="Transparent">

    <Border Style="{StaticResource RoundedPanelStyle}"
            Width="880"
            MinHeight="380"
            Padding="50,40">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource PrimaryRedBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,15"
                    Margin="0,10,0,20">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblDate]}"
                               Style="{StaticResource SectionTitleText}"
                               Foreground="{StaticResource PrimaryRedBrush}"
                               FontSize="14"
                               HorizontalAlignment="Left"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblParticipants]}"
                               Style="{StaticResource SectionTitleText}"
                               Foreground="{StaticResource PrimaryRedBrush}"
                               FontSize="14"
                               HorizontalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblFinalScores]}"
                               Style="{StaticResource SectionTitleText}"
                               Foreground="{StaticResource PrimaryRedBrush}"
                               FontSize="14"
                               HorizontalAlignment="Right"/>
                </Grid>

            </Border>
            <Grid Grid.Row="1" 
                  MinHeight="180"
                  Margin="0,10,0,25">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding MatchDate}"
                           Style="{StaticResource TextCream}"
                           FontSize="14"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>
                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding Participants}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Style="{StaticResource TextCream}"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,12"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl Grid.Column="2"
                              ItemsSource="{Binding FinalScores}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Style="{StaticResource TextCream}"
                                       FontSize="14"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,0,12"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
            <Button x:Name="btnBack"
                    Grid.Row="2"
                    Style="{StaticResource OutlineButton}"
                    MinWidth="220" MinHeight="52"
                    HorizontalAlignment="Right"
                    Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnBack]}"
                    Command="{Binding BackCommand}"/>

        </Grid>

    </Border>
</UserControl>
