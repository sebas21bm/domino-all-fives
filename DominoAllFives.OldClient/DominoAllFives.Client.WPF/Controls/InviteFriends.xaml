<UserControl x:Class="DominoAllFives.Client.WPF.Controls.InviteFriends"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DominoAllFives.Client.WPF.Controls"
             xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600"
             Background="Transparent">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="750" Height="650" Style="{StaticResource RoundedPanelStyle}">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="10" Opacity="0.5"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,20">
                    <StackPanel Margin="10,0,20,0">
                        <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblOnline]}" 
                                   Style="{StaticResource SectionTitleText}" 
                                   Margin="0,0,0,20"/>

                        <ItemsControl ItemsSource="{Binding OnlineFriends}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,25">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0" Style="{StaticResource SmallAvatarBorderStyle}" Margin="0,0,20,0">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding AvatarPath}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                            <Border BorderBrush="{StaticResource CreamLightBrush}" BorderThickness="2" Padding="10,8">
                                                <TextBlock Text="{Binding Username}" 
                                                           Style="{StaticResource DataValueText}" 
                                                           HorizontalAlignment="Center"/>
                                            </Border>

                                            <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[MessageLobby_msgAlreadyInvited]}" 
                                                       Style="{StaticResource ValidationText}"
                                                       Margin="0,5,0,0" 
                                                       HorizontalAlignment="Center"
                                                       Visibility="{Binding IsInvited, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" 
                                                Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[InviteFriends_btnInvite]}"
                                                Style="{StaticResource DarkButton}"
                                                IsEnabled="{Binding CanInvite}"
                                                Command="{Binding DataContext.SendInviteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Top"
                                                Height="42" Width="190"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,10,0,30"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblOffline]}" 
                                   Style="{StaticResource SectionTitleText}" 
                                   Margin="0,0,0,20"/>

                        <ItemsControl ItemsSource="{Binding OfflineFriends}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,25">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0" Style="{StaticResource SmallAvatarBorderStyle}" Margin="0,0,20,0" Opacity="0.5">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding AvatarPath}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                            <Border BorderBrush="{StaticResource CreamLightBrush}" BorderThickness="2" Padding="10,8">
                                                <TextBlock Text="{Binding Username}" 
                                                           Style="{StaticResource DataValueText}" 
                                                           HorizontalAlignment="Center"/>
                                            </Border>

                                            <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[MessageLobby_msgAlreadyInvited]}" 
                                                       Style="{StaticResource ValidationText}"
                                                       Margin="0,5,0,0" 
                                                       HorizontalAlignment="Center"
                                                       Visibility="{Binding IsInvited, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" 
                                                Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[InviteFriends_btnInvite]}"
                                                Style="{StaticResource DarkButton}"
                                                IsEnabled="{Binding CanInvite}"
                                                Command="{Binding DataContext.SendInviteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Top"
                                                Height="42" Width="190"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <Button Grid.Row="1"
                        Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnBack]}"
                        Style="{StaticResource OutlineButton}" 
                        Width="220" Height="45" 
                        Margin="0,15,0,0"
                        HorizontalAlignment="Center"
                        Command="{Binding CloseInviteModalCommand}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
