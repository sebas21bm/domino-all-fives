<UserControl x:Class="DominoAllFives.Client.WPF.Controls.FriendRequestInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DominoAllFives.Client.WPF.Controls"
             mc:Ignorable="d" 
             xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization;assembly=DominoAllFives.Client.WPF"
             Background="Transparent">
    <Border Style="{StaticResource RoundedPanelStyle}" 
            Width="750" 
            Padding="40,35"
            HorizontalAlignment="Center" 
            VerticalAlignment="Center">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="10,0,20,0">
                    <TextBlock Text="{Binding Username}" 
                               Style="{StaticResource PageTitleText}" 
                               FontSize="36"
                               Foreground="{StaticResource CreamLightBrush}"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblDate]}" 
                                   Style="{StaticResource FieldLabelText}" 
                                   FontSize="20"
                                   Foreground="{StaticResource CreamLightBrush}"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding FormattedRequestDate}" 
                                   Style="{StaticResource FieldLabelText}" 
                                   FontSize="20"
                                   Foreground="{StaticResource CreamLightBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" Width="140" Height="140">
                    <Ellipse Width="100" Height="25" Fill="#B21818" 
                             VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-5">
                        <Ellipse.Effect>
                            <BlurEffect Radius="15"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <Border Width="120" Height="120" CornerRadius="60" 
                            BorderBrush="{StaticResource CreamLightBrush}" BorderThickness="4" 
                            Background="{StaticResource DarkBgBrush}" ClipToBounds="True" 
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="{Binding ProfilePicture}" Stretch="UniformToFill"/>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="1" BorderBrush="{StaticResource CreamLightBrush}" BorderThickness="0,0,0,1" Opacity="0.4" Margin="0,0,0,25"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnAccept"
                        Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnAccept]}"
                        Style="{StaticResource PrimaryButton}"
                        Width="220" Height="48"
                        FontSize="15"
                        Margin="0,0,20,0"
                        Command="{Binding AcceptCommand}"/>

                <Button x:Name="btnDecline"
                        Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Friends_btnDeclineRequest]}"
                        Style="{StaticResource OutlineButton}"
                        Width="220" Height="48"
                        FontSize="15"
                        Command="{Binding DeclineCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
