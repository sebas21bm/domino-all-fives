<UserControl x:Class="DominoAllFives.Client.WPF.Controls.CustomMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DominoAllFives.Client.WPF.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>

        <Border Style="{StaticResource RoundedPanelStyle}" 
                Background="{StaticResource CreamLightBrush}"
                Width="600" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">

            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,25">

                    <Image x:Name="imgDialogIcon" 
                           Source="{Binding IconPath}" 
                           Width="64"
                           Height="64"
                           Stretch="Uniform" 
                           Margin="0,0,20,0"/>

                    <TextBlock x:Name="txbDialogTitle" 
                               Text="{Binding Title}" 
                               Style="{StaticResource SectionTitleText}"
                               Foreground="{StaticResource DarkBgBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="txbDialogMessage" 
                           Grid.Row="1" 
                           Text="{Binding Message}" 
                           Style="{StaticResource BodyText}"
                           Foreground="{StaticResource DarkBgBrush}"
                           FontSize="14"
                           TextAlignment="Left"
                           TextWrapping="Wrap"
                           Margin="30,10,30,30"/>

                <Border Grid.Row="2" 
                        Style="{StaticResource HorizontalDividerStyle}" 
                        Margin="30,0,30,25"/>

                <StackPanel Grid.Row="3" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center">

                    <Button x:Name="btnAccept" 
                            Content="{Binding AcceptButtonText}" 
                            Command="{Binding AcceptCommand}" 
                            Style="{StaticResource DarkButton}" 
                            MinHeight="40"
                            MinWidth="160"
                            Margin="15,0"/>

                    <Button x:Name="btnCancel" 
                            Content="{Binding CancelButtonText}" 
                            Command="{Binding CancelCommand}" 
                            Visibility="{Binding IsCancelVisible, Converter={StaticResource BoolToVis}}" 
                            Style="{StaticResource DarkButton}" 
                            MinHeight="40"
                            MinWidth="160"
                            Margin="15,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>