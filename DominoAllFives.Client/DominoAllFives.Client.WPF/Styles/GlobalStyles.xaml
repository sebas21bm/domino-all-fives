<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="PressStartFont">./../Assets/Fonts/#Press Start 2P</FontFamily>

    <!-- Color palette -->
    <SolidColorBrush x:Key="PrimaryRedBrush" Color="#CC2222"/>
    <SolidColorBrush x:Key="DarkRedBrush" Color="#8A1212"/>
    <SolidColorBrush x:Key="CreamLightBrush" Color="#F0EAD8"/>
    <SolidColorBrush x:Key="DarkBgBrush" Color="#222222"/>
    <SolidColorBrush x:Key="GrayPanelBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="DisabledGrayBrush" Color="#666666"/>
    <SolidColorBrush x:Key="PureBlackBrush" Color="#000000"/>

    <!-- Buttons styles -->
    <!-- Red button -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource PressStartFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Background" Value="{StaticResource PrimaryRedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource CreamLightBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DarkRedBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" 
                                          Margin="10,6"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark button -->
    <Style x:Key="DarkButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource PressStartFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Background" Value="{StaticResource DarkBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource CreamLightBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GrayPanelBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" 
                                          Margin="10,6"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tansparent button -->
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource PressStartFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryRedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryRedBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" 
                                          Margin="10,6"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Gray button -->
    <Style x:Key="DisabledButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource PressStartFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Background" Value="{StaticResource DarkBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource DisabledGrayBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GrayPanelBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" 
                                          Margin="10,6"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cream TextBox style -->
    <Style x:Key="CreamTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource PressStartFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource CreamLightBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CreamLightBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="0"
                            SnapsToDevicePixels="True">
                        <!-- ScrollViewer es obligatorio en los TextBox de WPF para que el texto funcione bien -->
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Font for every TextBlock-->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PressStartFont}"/>
    </Style>

    <!-- Cream TextBox -->
    <Style x:Key="TextCream" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource CreamLightBrush}"/>
    </Style>

    <!-- Red TextBox -->
    <Style x:Key="TextRed" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryRedBrush}"/>
    </Style>

    <!-- White TextBox -->
    <Style x:Key="TextWhite" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!--  Gray TextBox -->
    <Style x:Key="TextGray" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource DisabledGrayBrush}"/>
    </Style>

</ResourceDictionary>