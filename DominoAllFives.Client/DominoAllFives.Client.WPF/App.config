<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="DominoAllFives.Client.WPF.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <userSettings>
    <DominoAllFives.Client.WPF.Properties.Settings>
      <setting name="LanguageCode" serializeAs="String">
        <value>es-MX</value>
      </setting>
    </DominoAllFives.Client.WPF.Properties.Settings>
  </userSettings>
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="DemoTcpBinding" openTimeout="00:00:05" closeTimeout="00:00:05" sendTimeout="00:00:10" receiveTimeout="00:02:00" maxReceivedMessageSize="16777216">
          <readerQuotas maxArrayLength="16777216" maxStringContentLength="8192" />
        </binding>
        <binding name="LobbyTcpBinding" openTimeout="00:00:05" closeTimeout="00:00:05" sendTimeout="00:00:10" receiveTimeout="00:10:00" maxReceivedMessageSize="16777216" maxBufferSize="16777216">
          <readerQuotas maxArrayLength="16777216" maxStringContentLength="8192" />
        </binding>
      </netTcpBinding>
    </bindings>
    <client>
      <endpoint name="AuthenticationEndpoint" address="net.tcp://localhost:8733/Domino/account" binding="netTcpBinding" bindingConfiguration="DemoTcpBinding" contract="DominoAllFivesService.ISessionAccount" />
      <endpoint name="RankingEndpoint" address="net.tcp://localhost:8733/Domino/ranking" binding="netTcpBinding" bindingConfiguration="DemoTcpBinding" contract="DominoAllFivesService.IRankingRemoteService" />
      <endpoint name="LobbyEndpoint" address="net.tcp://localhost:8733/Domino/lobby" binding="netTcpBinding" bindingConfiguration="LobbyTcpBinding" contract="DominoAllFivesService.ILobbyService" />
    </client>
  </system.serviceModel>
</configuration>