<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<configSections>
		<section name="entityFramework"
                 type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
                 requirePermission="false" />
		<sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
			<section name="DominoAllFives.Client.WPF.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
		</sectionGroup>
	</configSections>

	<userSettings>
		<DominoAllFives.Client.WPF.Properties.Settings>
			<setting name="LanguageCode" serializeAs="String">
				<value>es-MX</value>
			</setting>
		</DominoAllFives.Client.WPF.Properties.Settings>
	</userSettings>

	<entityFramework>
		<providers>
			<provider invariantName="System.Data.SqlClient"
                      type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
		</providers>
	</entityFramework>

	<connectionStrings configSource="Configuration\DatabaseConnection.config" />
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="DemoTcpBinding" openTimeout="00:00:05" closeTimeout="00:00:05"
                 sendTimeout="00:00:10" receiveTimeout="00:02:00"
                 maxReceivedMessageSize="16777216">
          <readerQuotas maxArrayLength="16777216" maxStringContentLength="8192" />
        </binding>
      </netTcpBinding>
    </bindings>
    <client>
      <endpoint name="AuthenticationEndpoint" address="net.tcp://localhost:8733/Domino/account"
                binding="netTcpBinding" bindingConfiguration="DemoTcpBinding"
                contract="DominoAllFivesService.IAuthenticationService" />
      <endpoint name="RankingEndpoint" address="net.tcp://localhost:8733/Domino/ranking"
                binding="netTcpBinding" bindingConfiguration="DemoTcpBinding"
                contract="DominoAllFivesService.IRankingRemoteService" />
    </client>
  </system.serviceModel>
</configuration>
