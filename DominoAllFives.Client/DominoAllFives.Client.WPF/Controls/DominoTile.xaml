<UserControl x:Class="DominoAllFives.Client.WPF.Controls.DominoTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DominoAllFives.Client.WPF.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="60">

    <Border x:Name="bdrTileFrame"
            Width="56"
            Height="112"
            Background="{StaticResource CreamLightBrush}"
            BorderBrush="{StaticResource PureBlackBrush}"
            BorderThickness="3"
            CornerRadius="4"
            UseLayoutRounding="True"
            SnapsToDevicePixels="True">

        <Grid x:Name="grdTileContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Viewbox Grid.Row="0" Margin="4">
                <Grid x:Name="grdTopPips" Width="30" Height="30">
                    <Ellipse x:Name="pipTopTL" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{Binding PipBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Ellipse x:Name="pipTopTR" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{Binding PipBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Ellipse x:Name="pipTopML" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{Binding PipBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Ellipse x:Name="pipTopC" Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding PipBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Ellipse x:Name="pipTopMR" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{Binding PipBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Ellipse x:Name="pipTopBL" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{Binding PipBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Ellipse x:Name="pipTopBR" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{Binding PipBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Grid>
            </Viewbox>

            <Border Grid.Row="1" 
                    Height="2" 
                    Background="{StaticResource PureBlackBrush}"/>
            
            <Viewbox Grid.Row="2" Margin="4">
                <Grid x:Name="grdBottomPips" Width="30" Height="30">
                    <Ellipse x:Name="pipBottomTL" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{Binding PipBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Ellipse x:Name="pipBottomTR" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{Binding PipBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Ellipse x:Name="pipBottomML" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{Binding PipBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Ellipse x:Name="pipBottomC" Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding PipBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Ellipse x:Name="pipBottomMR" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{Binding PipBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Ellipse x:Name="pipBottomBL" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{Binding PipBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Ellipse x:Name="pipBottomBR" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{Binding PipBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Grid>
            </Viewbox>
        </Grid>
    </Border>
</UserControl>
