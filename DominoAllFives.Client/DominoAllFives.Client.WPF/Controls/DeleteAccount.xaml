<UserControl x:Class="DominoAllFives.Client.WPF.Controls.DeleteAccount"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DominoAllFives.Client.WPF.Controls"
             xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization;assembly=DominoAllFives.Client.WPF"
             Background="Transparent">

    <Border Style="{StaticResource RoundedPanelStyle}" 
            Width="700" 
            Padding="40,35"
            HorizontalAlignment="Center" 
            VerticalAlignment="Center">

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="550">
            <Image Source="/Assets/Images/logoFull.png" 
                   Style="{StaticResource FullLogoStyle}"
                   Width="280" Height="80"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

            <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[DeleteAccount_lblCurrentPassword]}" 
                       Style="{StaticResource FieldLabelText}" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,8"/>

            <PasswordBox x:Name="pwdCurrentPassword" 
                         Style="{StaticResource CreamPasswordBox}" 
                         Height="48"
                         Margin="0,0,0,15"/>

            <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[DeleteAccount_lblDeleteAccountWarning]}" 
                       Style="{StaticResource FieldLabelText}" 
                       FontSize="13"
                       Foreground="{StaticResource PrimaryRedBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,25"/>

            <Button x:Name="btnConfirmDelete"
                    Style="{StaticResource PrimaryButton}"
                    Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnAccept]}"
                    Height="50"
                    Margin="0,0,0,12"
                    Command="{Binding ConfirmDeleteCommand}"/>

            <Button x:Name="btnCancel"
                    Style="{StaticResource OutlineButton}"
                    Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnCancel]}"
                    Height="50"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Border>
</UserControl>
