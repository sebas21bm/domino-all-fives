<UserControl x:Class="DominoAllFives.Client.WPF.Controls.RecoverAccount"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DominoAllFives.Client.WPF.Controls"
             mc:Ignorable="d" 
             xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization;assembly=DominoAllFives.Client.WPF"
             Background="Transparent">
    <Border Style="{StaticResource RoundedPanelStyle}" 
            Width="650" 
            Padding="30,50"
            HorizontalAlignment="Center" 
            VerticalAlignment="Center">

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">

            <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[RecoverAccount_lblTitle]}" 
                       Style="{StaticResource PageTitleText}" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,45"/>

            <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblEmail]}" 
                       Style="{StaticResource FieldLabelText}" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,10"/>
            <TextBox x:Name="txtEmail" 
                     Style="{StaticResource CreamTextBox}" 
                     Height="48"/>
            <TextBlock x:Name="txbEmailError" 
                       Style="{StaticResource ValidationText}" 
                       Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblEmailRequired]}" 
                       Visibility="Hidden"
                       HorizontalAlignment="Left"
                       Margin="0,5,0,45"/>

            <Button x:Name="btnSendCode"
                    Style="{StaticResource PrimaryButton}"
                    Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[RecoverAccount_btnSendVerificationCode]}"
                    Height="54"
                    Margin="0,0,0,15"
                    Command="{Binding SendCodeCommand}"/>

            <Button x:Name="btnCancel"
                    Style="{StaticResource OutlineButton}"
                    Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnCancel]}"
                    Height="54"
                    Command="{Binding CancelCommand}"/>

        </StackPanel>
    </Border>
</UserControl>
