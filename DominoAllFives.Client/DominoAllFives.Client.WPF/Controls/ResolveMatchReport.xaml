<UserControl x:Class="DominoAllFives.Client.WPF.Controls.ResolveMatchReport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DominoAllFives.Client.WPF.Controls"
             xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization;assembly=DominoAllFives.Client.WPF"
             mc:Ignorable="d"
             Background="Transparent">

    <Border Style="{StaticResource RoundedPanelStyle}"
            Width="800"
            Padding="45,35">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblDecision]}"
                       Style="{StaticResource SectionTitleText}"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

            <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,30">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="btnValidMatch"
                        Grid.Column="0"
                        MinHeight="54"
                        Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[ResolveMatchReport_btnValidMatch]}"
                        Command="{Binding SelectValidMatchCommand}"
                        FontSize="11">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsValidMatchSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryRedBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource DarkRedBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource CreamLightBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="btnInvalidMatch"
                        Grid.Column="2"
                        MinHeight="54"
                        Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[ResolveMatchReport_btnInvalidMatch]}"
                        Command="{Binding SelectInvalidMatchCommand}"
                        FontSize="11">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInvalidMatchSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryRedBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource DarkRedBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource CreamLightBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </Grid>

            <TextBlock Grid.Row="2"
                       Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblReason]}"
                       Style="{StaticResource FieldLabelText}"
                       FontSize="15"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,12"/>

            <TextBox x:Name="txtReason"
                     Grid.Row="3"
                     MinHeight="130"
                     Margin="0,0,0,35"
                     Style="{StaticResource CreamTextBox}"
                     Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     Padding="15,12"
                     FontSize="13"/>
            <Grid Grid.Row="4" HorizontalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnSend"
                        Grid.Column="0"
                        Style="{StaticResource PrimaryButton}"
                        MinHeight="52"
                        Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnSend]}"
                        Command="{Binding SendResolutionCommand}"/>

                <Button x:Name="btnBack"
                        Grid.Column="2"
                        Style="{StaticResource OutlineButton}"
                        MinHeight="52"
                        Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnBack]}"
                        Command="{Binding BackCommand}"/>

            </Grid>

        </Grid>

    </Border>
</UserControl>
