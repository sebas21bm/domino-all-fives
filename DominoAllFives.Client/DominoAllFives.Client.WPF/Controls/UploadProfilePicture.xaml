<UserControl x:Class="DominoAllFives.Client.WPF.Controls.UploadProfilePicture"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DominoAllFives.Client.WPF.Controls"
             xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization;assembly=DominoAllFives.Client.WPF"
             Background="Transparent">
    <Border Style="{StaticResource RoundedPanelStyle}" 
            Width="650" 
            Padding="30,40"
            HorizontalAlignment="Center" 
            VerticalAlignment="Center">

        <Grid>
            <Button x:Name="btnBack"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Style="{StaticResource BackButton}"
                    ToolTip="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnBack]}"
                    Command="{Binding CancelCommand}"/>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Margin="0,15,0,0">

                <Image Source="/Assets/Images/logoFull.png" 
                       Style="{StaticResource FullLogoStyle}"
                       Width="320" Height="100"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

                <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[UploadProfilePicture_lblInstruction]}" 
                           Style="{StaticResource FieldLabelText}" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,25"/>

                <Button x:Name="btnSelectPicture" 
                        Width="180" Height="180" 
                        Style="{StaticResource IconButton}" 
                        HorizontalAlignment="Center" 
                        Margin="0,0,0,45" 
                        Command="{Binding SelectImageCommand}">
                    <Grid>
                        <Ellipse Fill="{StaticResource DarkBgBrush}" 
                                 Stroke="{StaticResource CreamLightBrush}" 
                                 StrokeThickness="4"/>

                        <Image x:Name="imgProfileAvatar" 
                               Stretch="UniformToFill">
                            <Image.Clip>
                                <EllipseGeometry Center="90,90" RadiusX="86" RadiusY="86"/>
                            </Image.Clip>
                        </Image>
                    </Grid>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnAddPhoto"
                            Style="{StaticResource PrimaryButton}"
                            Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[UploadProfilePicture_btnAddPhoto]}"
                            Width="180" Height="54"
                            Margin="0,0,15,0"
                            Command="{Binding UploadCommand}"/>
                    <Button x:Name="btnSkipPhoto"
                            Style="{StaticResource OutlineButton}"
                            Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[UploadProfilePicture_btnSkipPhoto]}"
                            Width="180" Height="54"
                            Margin="15,0,0,0"
                            Command="{Binding SkipCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
