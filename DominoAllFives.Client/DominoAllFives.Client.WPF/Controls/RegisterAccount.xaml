<UserControl x:Class="DominoAllFives.Client.WPF.Controls.RegisterAccount"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DominoAllFives.Client.WPF.Controls"
             mc:Ignorable="d" 
             xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization;assembly=DominoAllFives.Client.WPF"
             Background="Transparent">
    <Border Style="{StaticResource RoundedPanelStyle}" 
            Width="650" 
            Padding="30,40"
            HorizontalAlignment="Center" 
            VerticalAlignment="Center">

        <Grid>
            <!-- Back Button -->
            <Button x:Name="btnBack"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Style="{StaticResource BackButton}"
                    ToolTip="{x:Static loc:Resources.Global_btnBack}"
                    Click="BackButtonClick"/>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Margin="0,15,0,0">

                <!-- Title -->
                <TextBlock Text="{x:Static loc:Resources.RegisterAccount_lblTitle}" 
                           Style="{StaticResource PageTitleText}" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,40"/>

                <!-- Email Field -->
                <TextBlock Text="{x:Static loc:Resources.Global_lblEmail}" 
                           Style="{StaticResource FieldLabelText}" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,10"/>
                <TextBox x:Name="txtEmail" 
                         Style="{StaticResource CreamTextBox}" 
                         Height="48"/>
                <TextBlock x:Name="txbEmailError" 
                           Style="{StaticResource ValidationText}" 
                           Text="{x:Static loc:Resources.Global_lblEmailRequired}" 
                           Visibility="Hidden"
                           HorizontalAlignment="Left"
                           Margin="0,5,0,15"/>

                <!-- Username Field -->
                <TextBlock Text="{x:Static loc:Resources.RegisterAccount_lblUsername}" 
                           Style="{StaticResource FieldLabelText}" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,10"/>
                <TextBox x:Name="txtUsername" 
                         Style="{StaticResource CreamTextBox}" 
                         Height="48"/>
                <TextBlock x:Name="txbUsernameError" 
                           Style="{StaticResource ValidationText}" 
                           Text="{x:Static loc:Resources.RegisterAccount_lblUsernameRequired}" 
                           Visibility="Hidden"
                           HorizontalAlignment="Left"
                           Margin="0,5,0,15"/>

                <!-- Password Field -->
                <TextBlock Text="{x:Static loc:Resources.Global_lblPassword}" 
                           Style="{StaticResource FieldLabelText}" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,10"/>
                <PasswordBox x:Name="pwdPassword" 
                             Style="{StaticResource CreamPasswordBox}" 
                             Height="48"/>
                <TextBlock x:Name="txbPasswordError" 
                           Style="{StaticResource ValidationText}" 
                           Text="{x:Static loc:Resources.Global_lblPasswordRequired}" 
                           Visibility="Hidden"
                           HorizontalAlignment="Left"
                           Margin="0,5,0,15"/>

                <!-- Confirm Password Field -->
                <TextBlock Text="{x:Static loc:Resources.Global_lblConfirmPassword}" 
                           Style="{StaticResource FieldLabelText}" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,10"/>
                <PasswordBox x:Name="pwdConfirmPassword" 
                             Style="{StaticResource CreamPasswordBox}" 
                             Height="48"/>
                <TextBlock x:Name="txbConfirmPasswordError" 
                           Style="{StaticResource ValidationText}" 
                           Text="" 
                           Visibility="Hidden"
                           HorizontalAlignment="Left"
                           Margin="0,5,0,30"/>

                <!-- Register Action -->
                <Button x:Name="btnRegister"
                        Style="{StaticResource OutlineButton}"
                        Content="{x:Static loc:Resources.RegisterAccount_btnRegister}"
                        Height="54"
                        Click="RegisterButtonClick"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
