<UserControl x:Class="DominoAllFives.Client.WPF.Controls.RegisterAccount"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DominoAllFives.Client.WPF.Controls"
             xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization;assembly=DominoAllFives.Client.WPF"
             xmlns:converters="clr-namespace:DominoAllFives.Client.WPF.Converters"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        <converters:PasswordBoxesConverter x:Key="PasswordBoxesConverter"/>
    </UserControl.Resources>

    <Border Style="{StaticResource RoundedPanelStyle}"
            Width="650"
            Padding="30,40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

        <Grid>
            <Button x:Name="btnBack"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Style="{StaticResource BackButton}"
                    ToolTip="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnBack]}"
                    Command="{Binding CancelCommand}"/>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="400"
                        Margin="0,15,0,0">

                <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[RegisterAccount_lblTitle]}"
                           Style="{StaticResource PageTitleText}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblEmail]}"
                           Style="{StaticResource FieldLabelText}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBox x:Name="txtEmail"
                         Style="{StaticResource CreamTextBox}"
                         Height="48"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <Grid Height="30">
                    <TextBlock x:Name="txbEmailError"
                               Style="{StaticResource ValidationText}"
                               Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblEmailRequired]}"
                               Visibility="{Binding IsEmailRequiredVisible, Converter={StaticResource BoolToVis}}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[RegisterAccount_lblUsername]}"
                           Style="{StaticResource FieldLabelText}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBox x:Name="txtUsername"
                         Style="{StaticResource CreamTextBox}"
                         Height="48"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                <Grid Height="30">
                    <TextBlock x:Name="txbUsernameError"
                               Style="{StaticResource ValidationText}"
                               Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[RegisterAccount_lblUsernameRequired]}"
                               Visibility="{Binding IsUsernameRequiredVisible, Converter={StaticResource BoolToVis}}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblPassword]}"
                           Style="{StaticResource FieldLabelText}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <PasswordBox x:Name="pwdPassword"
                             Style="{StaticResource CreamPasswordBox}"
                             Height="48"/>

                <Grid Height="30">
                    <TextBlock x:Name="txbPasswordError"
                               Style="{StaticResource ValidationText}"
                               Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblPasswordRequired]}"
                               Visibility="{Binding IsPasswordRequiredVisible, Converter={StaticResource BoolToVis}}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblConfirmPassword]}"
                           Style="{StaticResource FieldLabelText}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <PasswordBox x:Name="pwdConfirmPassword"
                             Style="{StaticResource CreamPasswordBox}"
                             Height="48"/>

                <Grid Height="40">
                    <TextBlock x:Name="txbConfirmPasswordError"
                               Style="{StaticResource ValidationText}"
                               Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblPasswordRequired]}"
                               Visibility="{Binding IsConfirmPasswordRequiredVisible, Converter={StaticResource BoolToVis}}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Margin="0,8,0,0"/>
                </Grid>

                <Button x:Name="btnRegister"
                        Style="{StaticResource OutlineButton}"
                        Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[RegisterAccount_btnRegister]}"
                        Height="54"
                        Command="{Binding RegisterCommand}">

                    <Button.CommandParameter>
                        <MultiBinding Converter="{StaticResource PasswordBoxesConverter}">
                            <Binding ElementName="pwdPassword"/>
                            <Binding ElementName="pwdConfirmPassword"/>
                        </MultiBinding>
                    </Button.CommandParameter>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>