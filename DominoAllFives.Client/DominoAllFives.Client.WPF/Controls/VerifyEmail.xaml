<UserControl x:Class="DominoAllFives.Client.WPF.Controls.VerifyEmail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DominoAllFives.Client.WPF.Controls"
             mc:Ignorable="d" 
             xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization;assembly=DominoAllFives.Client.WPF"
             Background="Transparent">
    <Border Style="{StaticResource RoundedPanelStyle}" 
            Width="650" 
            Padding="30,50"
            HorizontalAlignment="Center" 
            VerticalAlignment="Center">

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
            <TextBlock Text="{x:Static loc:Resources.VerifyEmail_lblTitle}" 
                       Style="{StaticResource PageTitleText}" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,45"/>


            <TextBlock Text="{x:Static loc:Resources.VerifyEmail_lblCode}" 
                       Style="{StaticResource FieldLabelText}" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,15"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBox x:Name="txtDigit1" Style="{StaticResource CreamTextBox}" Width="55" Height="55" FontSize="18" HorizontalContentAlignment="Center" MaxLength="1" Margin="5,0"/>
                <TextBox x:Name="txtDigit2" Style="{StaticResource CreamTextBox}" Width="55" Height="55" FontSize="18" HorizontalContentAlignment="Center" MaxLength="1" Margin="5,0"/>
                <TextBox x:Name="txtDigit3" Style="{StaticResource CreamTextBox}" Width="55" Height="55" FontSize="18" HorizontalContentAlignment="Center" MaxLength="1" Margin="5,0"/>
                <TextBox x:Name="txtDigit4" Style="{StaticResource CreamTextBox}" Width="55" Height="55" FontSize="18" HorizontalContentAlignment="Center" MaxLength="1" Margin="5,0"/>
                <TextBox x:Name="txtDigit5" Style="{StaticResource CreamTextBox}" Width="55" Height="55" FontSize="18" HorizontalContentAlignment="Center" MaxLength="1" Margin="5,0"/>
                <TextBox x:Name="txtDigit6" Style="{StaticResource CreamTextBox}" Width="55" Height="55" FontSize="18" HorizontalContentAlignment="Center" MaxLength="1" Margin="5,0"/>
            </StackPanel>

            <TextBlock x:Name="txbCodeError" 
                       Style="{StaticResource ValidationText}" 
                       Text="{x:Static loc:Resources.MessageVerification_msgInvalidCode}" 
                       Visibility="Hidden"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>

            <!-- Resend Code Timer Button -->
            <Button x:Name="btnResendCode"
                    Style="{StaticResource IconButton}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,35">
                <TextBlock Style="{StaticResource TextGray}" FontSize="12">
                    <Run Text="{x:Static loc:Resources.VerifyEmail_btnResend}"/>
                    <Run Text=": "/>
                    <Run x:Name="runTimerDisplay" Text=""/>
                </TextBlock>
            </Button>

            <Button x:Name="btnVerifyCode"
                    Style="{StaticResource PrimaryButton}"
                    Content="{x:Static loc:Resources.VerifyEmail_btnVerify}"
                    Height="54"
                    Margin="0,0,0,15"
                    Click="VerifyCodeButtonClick"/>

            <Button x:Name="btnCancel"
                    Style="{StaticResource OutlineButton}"
                    Content="{x:Static loc:Resources.Global_btnCancel}"
                    Height="54"
                    Click="CancelButtonClick"/>

        </StackPanel>
    </Border>
</UserControl>
