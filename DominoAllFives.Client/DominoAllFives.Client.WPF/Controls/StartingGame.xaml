<UserControl x:Class="DominoAllFives.Client.WPF.Controls.StartingGame"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DominoAllFives.Client.WPF.Controls"
             xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="850" Height="280" 
                Background="{StaticResource GrayPanelBrush}" 
                CornerRadius="20"
                BorderBrush="{StaticResource HeaderLineBrush}"
                BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="25" ShadowDepth="10" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-0.033"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </StackPanel.RenderTransform>
                <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Lobby_lblStarting]}" 
                           FontFamily="{StaticResource PressStartFont}"
                           FontSize="67"
                           Foreground="{StaticResource CreamLightBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Lobby_lblGame]}" 
                           FontFamily="{StaticResource PressStartFont}"
                           FontSize="66"
                           Foreground="{StaticResource PrimaryRedBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
