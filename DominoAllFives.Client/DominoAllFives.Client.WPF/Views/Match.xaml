<Page x:Class="DominoAllFives.Client.WPF.Views.Match"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:DominoAllFives.Client.WPF.Controls"
      xmlns:local="clr-namespace:DominoAllFives.Client.WPF.Models"
      xmlns:strings="clr-namespace:DominoAllFives.Client.WPF.Localization"
      Background="{StaticResource DarkBgBrush}"
      Loaded="OnLoaded" Unloaded="OnUnloaded" KeepAlive="False"
      UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Page.Resources>
        <local:MatchValueConverter x:Key="MatchValueConverter"/>
        <Style x:Key="MatchActionButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="62"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="{StaticResource HeaderLineBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource CreamLightBrush}"/>
        </Style>
    </Page.Resources>
    <Viewbox Stretch="Uniform">
        <Grid Width="1600" Height="900" Background="{StaticResource DarkBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="78"/>
                <RowDefinition Height="94"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="160"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1310"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource HeaderBarStyle}">
                <Grid>
                    <Button x:Name="btnBack" Command="{Binding LeaveCommand}"
                            Style="{StaticResource BackButton}" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,36,0">
                        <TextBlock Text="{Binding Source={x:Static strings:LanguageManager.Instance}, Path=[Match_lblTarget]}"
                                   Style="{StaticResource TextGray}" FontSize="22" VerticalAlignment="Center" Margin="0,0,28,0"/>
                        <TextBlock x:Name="txbTargetPoints" Text="{Binding TargetPoints}"
                                   Style="{StaticResource TextCream}" FontSize="40" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding Opponents}" Grid.Column="0"
                              HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <TextBlock Text="{Binding Username}" Style="{StaticResource TextGray}"
                                           FontSize="13" VerticalAlignment="Center" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                                <Border Width="28" Height="54" Background="{StaticResource MutedTextBrush}"
                                        BorderBrush="{StaticResource PureBlackBrush}" BorderThickness="2" Margin="14,0,0,0">
                                    <TextBlock Text="{Binding TileCount}" Style="{StaticResource TextCream}"
                                               FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="28,0,0,0">
                    <TextBlock x:Name="txbTurn" Text="{Binding TurnText}" Style="{StaticResource TextCream}"
                               FontSize="16" TextWrapping="Wrap"/>
                    <TextBlock x:Name="txbRound" Text="{Binding RoundText}" Style="{StaticResource TextGray}"
                               FontSize="9" Margin="0,8,0,0"/>
                    <TextBlock x:Name="txbStatus" Text="{Binding Status}" Style="{StaticResource TextRed}"
                               FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" BorderBrush="#7B4A34" BorderThickness="16"
                    Background="{StaticResource GameBoardBackgroundBrush}">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="12">
                    <ItemsControl ItemsSource="{Binding BoardTiles}"
                                  Width="{Binding BoardWidth}" Height="{Binding BoardHeight}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Viewbox Width="48" Height="96" RenderTransformOrigin="0.5,0.5">
                                    <Viewbox.RenderTransform><RotateTransform Angle="{Binding Angle}"/></Viewbox.RenderTransform>
                                    <controls:DominoTile Width="56" Height="112" TopValue="{Binding TopValue}"
                                                        BottomValue="{Binding BottomValue}" TileType="{Binding TileType}"/>
                                </Viewbox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Viewbox>
            </Border>

            <Grid Grid.Row="3" Margin="18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ListBox ItemsSource="{Binding Hand}" SelectedItem="{Binding SelectedTile}"
                         BorderThickness="0" Background="Transparent" HorizontalAlignment="Center"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Viewbox Width="44" Height="88" Margin="7,0">
                                <controls:DominoTile Width="56" Height="112" TopValue="{Binding FirstValue}"
                                    BottomValue="{Binding SecondValue}"
                                    TileType="{Binding SpecialPower, Converter={StaticResource MatchValueConverter}}"/>
                            </Viewbox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Ends}" SelectedValuePath="End" SelectedValue="{Binding SelectedEnd}"
                              Width="155" Height="30" Margin="0,0,12,0"/>
                    <Button Content="{Binding Source={x:Static strings:LanguageManager.Instance}, Path=[Match_btnPlay]}"
                            Command="{Binding PlayCommand}" Style="{StaticResource PrimaryButton}" Height="30"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.RowSpan="2">
                    <Button Content="{Binding Source={x:Static strings:LanguageManager.Instance}, Path=[Match_btnPass]}"
                            Command="{Binding PassCommand}" Style="{StaticResource MatchActionButton}" Margin="0,0,0,10"/>
                    <Button Content="{Binding Source={x:Static strings:LanguageManager.Instance}, Path=[Match_btnStock]}"
                            Command="{Binding DrawCommand}" Style="{StaticResource MatchActionButton}"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="1"
                    BorderBrush="{StaticResource HeaderLineBrush}" BorderThickness="4,0,0,0">
                <Grid Margin="18,24,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="240"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Source={x:Static strings:LanguageManager.Instance}, Path=[Match_lblScores]}"
                               Style="{StaticResource TextGray}" FontSize="22" HorizontalAlignment="Center"/>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Players}" Margin="4,28,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="65"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Username}" Style="{StaticResource TextRed}"
                                               FontSize="16" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Points}" Style="{StaticResource TextCream}"
                                               FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Row="2" Text="{Binding Source={x:Static strings:LanguageManager.Instance}, Path=[Match_lblChat]}"
                               Style="{StaticResource TextGray}" FontSize="22" HorizontalAlignment="Center"/>
                    <Expander Grid.Row="4" Foreground="{StaticResource CreamLightBrush}" FontSize="9" Margin="0,12">
                        <Expander.Header>
                            <TextBlock MaxWidth="210" TextWrapping="Wrap" FontSize="8"
                                Text="{Binding Source={x:Static strings:LanguageManager.Instance}, Path=[Match_lblPreviousRound]}"/>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding RevealedHands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,5"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Button Grid.Row="5"
                            Content="{Binding Source={x:Static strings:LanguageManager.Instance}, Path=[Match_btnRefresh]}"
                            Command="{Binding RefreshCommand}" Style="{StaticResource DarkButton}" Height="34"/>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</Page>
