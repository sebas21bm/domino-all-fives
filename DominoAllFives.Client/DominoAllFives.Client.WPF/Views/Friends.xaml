<Window x:Class="DominoAllFives.Client.WPF.Views.Friends"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization"
        mc:Ignorable="d"
        Title="Domino All Fives"
        Width="1600"
        Height="900"
        MinWidth="1000"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        WindowState="Maximized"
        Background="{StaticResource DarkBgBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Background="{StaticResource DarkBgBrush}">

        <Viewbox Stretch="Uniform">

            <Grid Width="1600" Height="900"
                  Background="{StaticResource DarkBgBrush}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="822"/>
                </Grid.RowDefinitions>

                <!-- Barra superior -->
                <Border Grid.Row="0" Style="{StaticResource HeaderBarStyle}">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnBack"
                                Grid.Column="0"
                                Margin="10,7,0,7"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource BackButton}"
                                ToolTip="{x:Static loc:Resources.Global_btnBack}"/>

                        <Image Grid.Column="2"
                               Source="../Assets/Images/logoShort.png"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource ShortLogoStyle}"/>

                    </Grid>

                </Border>

                <!-- Contenido -->
                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="520"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Menú lateral -->
                    <Grid Grid.Column="0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="90"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Margin="30,25,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Text="{x:Static loc:Resources.Friends_lblTitle}"
                                   Style="{StaticResource PageTitleText}"/>

                        <StackPanel Grid.Row="1"
                                    Margin="72,40,30,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">

                            <Button x:Name="btnFriendList"
                                    MinWidth="270"
                                    MinHeight="62"
                                    Margin="0,0,0,55"
                                    Padding="18,12"
                                    Click="FriendListButtonClick"
                                    Style="{StaticResource SelectedNavigationTabButton}">

                                <TextBlock Text="{x:Static loc:Resources.Friends_btnFriendList}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>

                            </Button>

                            <Button x:Name="btnAddFriends"
                                    MinWidth="270"
                                    MinHeight="62"
                                    Margin="0,0,0,55"
                                    Padding="18,12"
                                    Click="AddFriendsButtonClick"
                                    Style="{StaticResource NavigationTabButton}">

                                <TextBlock Text="{x:Static loc:Resources.Friends_btnAddFriends}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>

                            </Button>

                            <Button x:Name="btnRequests"
                                    MinWidth="270"
                                    MinHeight="62"
                                    Padding="18,12"
                                    Click="RequestsButtonClick"
                                    Style="{StaticResource NavigationTabButton}">

                                <TextBlock Text="{x:Static loc:Resources.Friends_btnRequests}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>

                            </Button>

                        </StackPanel>

                    </Grid>

                    <!-- Separador vertical -->
                    <Border Grid.Column="1"
                            Margin="0,50,0,55"
                            Style="{StaticResource VerticalDividerStyle}"/>

                    <!-- Área dinámica -->
                    <Grid Grid.Column="2">

                        <!-- Lista de amigos -->
                        <Grid x:Name="grdFriendList"
                              Margin="55,65,85,40"
                              Visibility="Visible">

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">

                                <StackPanel>

                                    <TextBlock Margin="0,0,0,30"
                                               Text="{x:Static loc:Resources.Global_lblOnline}"
                                               Style="{StaticResource SectionTitleText}"/>

                                    <ListBox x:Name="lstOnlineFriends"
                                             Margin="55,0,0,45"
                                             ItemsSource="{Binding OnlineFriends}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">

                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,20"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>

                                        <ListBox.ItemTemplate>
                                            <DataTemplate>

                                                <Grid Width="760">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="85"/>
                                                        <ColumnDefinition Width="675"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Grid.Column="0"
                                                          Width="58"
                                                          Height="58"
                                                          HorizontalAlignment="Left">

                                                        <Ellipse Style="{StaticResource SmallAvatarBorderStyle}"/>

                                                        <Image HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource SmallAvatarImageStyle}">

                                                            <Image.Clip>
                                                                <EllipseGeometry Center="27,27"
                                                                                 RadiusX="27"
                                                                                 RadiusY="27"/>
                                                            </Image.Clip>

                                                        </Image>

                                                    </Grid>

                                                    <Border Grid.Column="1"
                                                            Style="{StaticResource OutlinedListItemStyle}">

                                                        <TextBlock Text="{Binding}"
                                                                   Style="{StaticResource TextCream}"
                                                                   FontSize="12"
                                                                   TextAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   HorizontalAlignment="Stretch"
                                                                   VerticalAlignment="Center"/>

                                                    </Border>

                                                </Grid>

                                            </DataTemplate>
                                        </ListBox.ItemTemplate>

                                    </ListBox>

                                    <TextBlock Margin="0,0,0,30"
                                               Text="{x:Static loc:Resources.Global_lblOffline}"
                                               Style="{StaticResource SectionTitleText}"/>

                                    <ListBox x:Name="lstOfflineFriends"
                                             Margin="55,0,0,0"
                                             ItemsSource="{Binding OfflineFriends}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">

                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,20"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>

                                        <ListBox.ItemTemplate>
                                            <DataTemplate>

                                                <Grid Width="760">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="85"/>
                                                        <ColumnDefinition Width="675"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Grid.Column="0"
                                                          Width="58"
                                                          Height="58"
                                                          HorizontalAlignment="Left">

                                                        <Ellipse Style="{StaticResource SmallAvatarBorderStyle}"/>

                                                        <Image HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource SmallAvatarImageStyle}">

                                                            <Image.Clip>
                                                                <EllipseGeometry Center="27,27"
                                                                                 RadiusX="27"
                                                                                 RadiusY="27"/>
                                                            </Image.Clip>

                                                        </Image>

                                                    </Grid>

                                                    <Border Grid.Column="1"
                                                            Style="{StaticResource OutlinedListItemStyle}">

                                                        <TextBlock Text="{Binding}"
                                                                   Style="{StaticResource TextCream}"
                                                                   FontSize="12"
                                                                   TextAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   HorizontalAlignment="Stretch"
                                                                   VerticalAlignment="Center"/>

                                                    </Border>

                                                </Grid>

                                            </DataTemplate>
                                        </ListBox.ItemTemplate>

                                    </ListBox>

                                    <TextBlock x:Name="txbNoFriends"
                                               Margin="0,70,0,0"
                                               Text="{x:Static loc:Resources.Global_lblNoFriends}"
                                               Style="{StaticResource TextGray}"
                                               FontSize="14"
                                               TextAlignment="Center"
                                               Visibility="Collapsed"/>

                                </StackPanel>

                            </ScrollViewer>

                        </Grid>

                        <!-- Agregar amigos -->
                        <Grid x:Name="grdAddFriends"
                              Margin="55,65,85,40"
                              Visibility="Collapsed">

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">

                                <StackPanel>

                                    <TextBlock Margin="0,0,0,35"
                                               Text="{x:Static loc:Resources.Global_lblOnline}"
                                               Style="{StaticResource SectionTitleText}"/>

                                    <!-- Búsqueda -->
                                    <Grid Margin="55,0,0,30">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="675"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="txtUsername"
                                                 Grid.Column="0"
                                                 MinHeight="58"
                                                 Style="{StaticResource CreamTextBox}"
                                                 FontSize="12"/>

                                        <Button x:Name="btnSearch"
                                                Grid.Column="2"
                                                MinWidth="150"
                                                MinHeight="58"
                                                Padding="18,12"
                                                Content="{x:Static loc:Resources.Global_btnSearch}"
                                                Style="{StaticResource PrimaryButton}"/>

                                    </Grid>

                                    <!-- Resultado de búsqueda -->
                                    <ListBox x:Name="lstSearchResults"
                                             Margin="55,0,0,20"
                                             ItemsSource="{Binding SearchResults}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">

                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>

                                        <ListBox.ItemTemplate>
                                            <DataTemplate>

                                                <Grid Width="760">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="85"/>
                                                        <ColumnDefinition Width="675"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Grid.Column="0"
                                                          Width="58"
                                                          Height="58">

                                                        <Ellipse Style="{StaticResource SmallAvatarBorderStyle}"/>

                                                        <Image Style="{StaticResource SmallAvatarImageStyle}">
                                                            <Image.Clip>
                                                                <EllipseGeometry Center="27,27"
                                                                                 RadiusX="27"
                                                                                 RadiusY="27"/>
                                                            </Image.Clip>
                                                        </Image>

                                                    </Grid>

                                                    <Border Grid.Column="1"
                                                            Style="{StaticResource OutlinedListItemStyle}">

                                                        <TextBlock Text="{Binding}"
                                                                   Style="{StaticResource TextCream}"
                                                                   FontSize="12"
                                                                   TextAlignment="Center"
                                                                   VerticalAlignment="Center"/>

                                                    </Border>

                                                </Grid>

                                            </DataTemplate>
                                        </ListBox.ItemTemplate>

                                    </ListBox>

                                    <Button x:Name="btnSendFriendRequest"
                                            MinWidth="500"
                                            MinHeight="62"
                                            Margin="140,0,0,95"
                                            Padding="20,14"
                                            HorizontalAlignment="Left"
                                            Content="{x:Static loc:Resources.Global_btnSendFriendRequest}"
                                            Style="{StaticResource PrimaryButton}"
                                            FontSize="12"/>

                                    <TextBlock Margin="5,0,0,30"
                                               Text="{x:Static loc:Resources.Friends_lblSentRequests}"
                                               Style="{StaticResource SectionTitleText}"/>

                                    <!-- Solicitudes enviadas -->
                                    <ListBox x:Name="lstSentRequests"
                                             Margin="55,0,0,0"
                                             ItemsSource="{Binding SentRequests}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">

                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,18"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>

                                        <ListBox.ItemTemplate>
                                            <DataTemplate>

                                                <Grid Width="850">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="85"/>
                                                        <ColumnDefinition Width="675"/>
                                                        <ColumnDefinition Width="25"/>
                                                        <ColumnDefinition Width="65"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Grid.Column="0"
                                                          Width="58"
                                                          Height="58">

                                                        <Ellipse Style="{StaticResource SmallAvatarBorderStyle}"/>

                                                        <Image Style="{StaticResource SmallAvatarImageStyle}">
                                                            <Image.Clip>
                                                                <EllipseGeometry Center="27,27"
                                                                                 RadiusX="27"
                                                                                 RadiusY="27"/>
                                                            </Image.Clip>
                                                        </Image>

                                                    </Grid>

                                                    <Border Grid.Column="1"
                                                            Style="{StaticResource OutlinedListItemStyle}">

                                                        <TextBlock Text="{Binding}"
                                                                   Style="{StaticResource TextCream}"
                                                                   FontSize="12"
                                                                   TextAlignment="Center"
                                                                   VerticalAlignment="Center"/>

                                                    </Border>

                                                    <Button Grid.Column="3"
                                                            Width="58"
                                                            Height="58"
                                                            Content="X"
                                                            Style="{StaticResource OutlineButton}"
                                                            FontSize="13"/>

                                                </Grid>

                                            </DataTemplate>
                                        </ListBox.ItemTemplate>

                                    </ListBox>

                                </StackPanel>

                            </ScrollViewer>

                        </Grid>

                        <!-- Solicitudes de amistad -->
                        <Grid x:Name="grdFriendRequests"
                              Margin="55,65,85,40"
                              Visibility="Collapsed">

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">

                                <StackPanel>

                                    <TextBlock Margin="0,0,0,40"
                                               Text="{x:Static loc:Resources.Friends_lblReceivedRequests}"
                                               Style="{StaticResource SectionTitleText}"/>

                                    <ListBox x:Name="lstReceivedRequests"
                                             Margin="55,0,0,0"
                                             ItemsSource="{Binding ReceivedRequests}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">

                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,22"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>

                                        <ListBox.ItemTemplate>
                                            <DataTemplate>

                                                <Grid Width="760">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="85"/>
                                                        <ColumnDefinition Width="675"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Grid.Column="0"
                                                          Width="58"
                                                          Height="58">

                                                        <Ellipse Style="{StaticResource SmallAvatarBorderStyle}"/>

                                                        <Image Style="{StaticResource SmallAvatarImageStyle}">
                                                            <Image.Clip>
                                                                <EllipseGeometry Center="27,27"
                                                                                 RadiusX="27"
                                                                                 RadiusY="27"/>
                                                            </Image.Clip>
                                                        </Image>

                                                    </Grid>

                                                    <Border Grid.Column="1"
                                                            Style="{StaticResource OutlinedListItemStyle}">

                                                        <TextBlock Text="{Binding}"
                                                                   Style="{StaticResource TextCream}"
                                                                   FontSize="12"
                                                                   TextAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   HorizontalAlignment="Stretch"
                                                                   VerticalAlignment="Center"/>

                                                    </Border>

                                                </Grid>

                                            </DataTemplate>
                                        </ListBox.ItemTemplate>

                                    </ListBox>

                                </StackPanel>

                            </ScrollViewer>

                        </Grid>

                    </Grid>

                </Grid>

            </Grid>

        </Viewbox>

    </Grid>

</Window>