<Page x:Class="DominoAllFives.Client.WPF.Views.Rankings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DominoAllFives.Client.WPF.Views"
      xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Rankings"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Grid Background="{StaticResource DarkBgBrush}">

        <Viewbox Stretch="Uniform">
            <Grid Width="1600" Height="900" Background="{StaticResource DarkBgBrush}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="822"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource HeaderBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnBack"
                                Grid.Column="0"
                                Margin="10,7,0,7"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource BackButton}"
                                ToolTip="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnBack]}"
                                Command="{Binding GoBackCommand}"/>

                        <Image Grid.Column="2"
                               Source="../Assets/Images/logoShort.png"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource ShortLogoStyle}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="90"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="120"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="55,30,85,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="txbRankingTitle"
                                   Grid.Column="0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Rankings_lblTitle]}" 
                                   Style="{StaticResource PageTitleText}"
                                   Foreground="{StaticResource PrimaryRedBrush}"/>

                        <ComboBox x:Name="cbxRankingFilter" 
                                  Grid.Column="2" 
                                  Style="{StaticResource DarkComboBox}" 
                                  VerticalAlignment="Center"
                                  Height="45">
                            <ComboBoxItem Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Profile_lblWins]}" IsSelected="True"/>
                        </ComboBox>
                    </Grid>
                    
                    <Grid Grid.Row="1" Margin="55,30,85,10">
                        <ListBox x:Name="lstLeaderboard" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch"
                                 ItemsSource="{Binding Leaderboard}">

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,15"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="1200" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Width="58" Height="58" HorizontalAlignment="Left">
                                            <Ellipse Style="{StaticResource SmallAvatarBorderStyle}"/>
                                            <Image Style="{StaticResource SmallAvatarImageStyle}">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="27,27" RadiusX="27" RadiusY="27"/>
                                                </Image.Clip>
                                            </Image>
                                        </Grid>

                                        <Border Grid.Column="1" Style="{StaticResource OutlinedListItemStyle}" Margin="20,0">
                                            <TextBlock Text="{Binding Username}" 
                                                       Style="{StaticResource TextCream}" 
                                                       FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource OutlinedListItemStyle}">
                                            <TextBlock Text="{Binding StatisticValue}" 
                                                       Style="{StaticResource TextRed}" 
                                                       FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,85,40" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="txbYourRanking" 
                                   Grid.Column="0"
                                   Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Rankings_lblYourRank]}" 
                                   Style="{StaticResource PageTitleText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0"/>

                        <Border Grid.Column="1" Style="{StaticResource OutlinedListItemStyle}" Background="{StaticResource GrayPanelBrush}">
                            <TextBlock x:Name="txbCurrentPlayerRank" 
                                       Text="{Binding CurrentPlayerRank}" 
                                       Style="{StaticResource TextRed}" 
                                       FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Page>