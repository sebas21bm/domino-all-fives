<Page x:Class="DominoAllFives.Client.WPF.Views.Lobby"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DominoAllFives.Client.WPF.Views"
      xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1600"
      Title="Lobby"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DropShadowEffect x:Key="RedGlowEffect" Color="#FF2222" BlurRadius="40" ShadowDepth="0" Opacity="0.85"/>
    </Page.Resources>

    <Grid Background="{StaticResource DarkBgBrush}">
        <Viewbox Stretch="Uniform">
            <Grid Width="1600" Height="900" Background="{StaticResource DarkBgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="130"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource HeaderBarStyle}">
                    <Grid>
                        <Button x:Name="btnBack"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="20,0,0,0"
                                Style="{StaticResource BackButton}"
                                Command="{Binding GoBackCommand}"/>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Lobby_lblRoomCode]}" 
                                       Style="{StaticResource TextGray}" 
                                       FontSize="14" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,15,0"/>

                            <Border BorderBrush="{StaticResource PrimaryRedBrush}" BorderThickness="2" Padding="15,6" Background="{StaticResource DarkBgBrush}">
                                <TextBlock Text="{Binding RoomCode}" 
                                           Style="{StaticResource TextRed}" 
                                           FontSize="20"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Lobby_lblTitle]}" 
                                   Style="{StaticResource PageTitleText}" 
                                   HorizontalAlignment="Right" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,30,0"/>
                    </Grid>
                </Border>
                
                <Border Grid.Row="1" 
                        Background="{StaticResource GameBoardBackgroundBrush}" 
                        BorderBrush="{StaticResource HeaderLineBrush}" 
                        BorderThickness="0,2,0,2">

                    <ItemsControl ItemsSource="{Binding Players}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="50,0" HorizontalAlignment="Center" ToolTip="Haz clic derecho para ver opciones">

                                    <Grid x:Name="gridPlayerItem" Background="Transparent">

                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Lobby_btnViewProfile]}"
                                                    Command="{Binding PlacementTarget.Tag.ViewProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                                <MenuItem Header="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Lobby_btnKick]}"
                                                    Command="{Binding PlacementTarget.Tag.KickPlayerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Style>
                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding PlacementTarget.Tag.IsHost, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True"/>
                                                                        <Condition Binding="{Binding PlacementTarget.DataContext.IsCurrentPlayer, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.Style>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Grid.ContextMenu>

                                        <Ellipse x:Name="imgPlayerAvatar" Width="210" Height="210" Stroke="{StaticResource CreamLightBrush}" StrokeThickness="4">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding AvatarPath}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>

                                    <Ellipse Fill="#2A000000" Width="160" Height="22" Margin="0,15,0,10"/>
                                    <TextBlock x:Name="lblPlayerName" 
                                               Text="{Binding Username}" 
                                               Style="{StaticResource SectionTitleText}" 
                                               HorizontalAlignment="Center"/>
                                </StackPanel>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsHost}" Value="True">
                                        <Setter TargetName="imgPlayerAvatar" Property="Effect" Value="{StaticResource RedGlowEffect}"/>
                                        <Setter TargetName="imgPlayerAvatar" Property="Stroke" Value="{StaticResource PrimaryRedBrush}"/>
                                        <Setter TargetName="lblPlayerName" Property="Foreground" Value="{StaticResource PrimaryRedBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border Grid.Row="1" Grid.RowSpan="2" 
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                        Width="420" Height="280" 
                        Margin="35,0,0,25"
                        Background="{StaticResource DarkBgBrush}" 
                        BorderBrush="{StaticResource GrayPanelBrush}" 
                        BorderThickness="2">
                    <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblChat]}" 
                               Style="{StaticResource TextGray}" 
                               FontSize="14" 
                               Margin="15,15,0,0"/>
                </Border>

                <StackPanel Grid.Row="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center" 
                            Margin="0,0,45,0">

                    <Button x:Name="btnInviteFriends"
                            Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Lobby_btnInviteFriends]}"
                            Style="{StaticResource DarkButton}" 
                            Width="300" Height="60" 
                            FontSize="12"
                            Margin="0,0,20,0"
                            Command="{Binding InviteFriendsCommand}"/>

                    <Button x:Name="btnStartGame"
                            Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Lobby_btnStartGame]}"
                            Width="280" Height="60"
                            FontSize="12"
                            Command="{Binding StartGameCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHost}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

            </Grid>
        </Viewbox>
    </Grid>
</Page>
