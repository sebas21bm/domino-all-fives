<Window x:Class="DominoAllFives.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Domino All Fives - Login" Height="450" Width="800"
        Background="#222222">
    <!-- Usando el fondo oscuro general -->

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

        <!-- Botón 1: Estilo Rojo Principal (Texto simulando el recurso .resx) -->
        <Button Style="{StaticResource PrimaryButton}" 
                Content="INICIAR SESION" 
                Margin="0,0,0,15"/>

        <!-- Botón 2: Estilo Oscuro -->
        <Button Style="{StaticResource DarkButton}" 
                Content="INICIAR SESION" 
                Margin="0,0,0,15"/>

        <!-- Botón 3: Estilo Delineado (Outline) -->
        <Button Style="{StaticResource OutlineButton}" 
                Content="VOLVER" 
                Margin="0,0,0,15"/>

        <!-- Botón 4: Estilo gris -->
        <Button Style="{StaticResource DisabledButton}" 
            Content="INICIAR SESION" 
            Margin="0,0,0,15"/>

    </StackPanel>
</Window>