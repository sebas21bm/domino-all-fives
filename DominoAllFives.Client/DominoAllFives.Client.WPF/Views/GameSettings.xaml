<Page x:Class="DominoAllFives.Client.WPF.Views.GameSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization"
        mc:Ignorable="d"
        Title="Domino All Fives"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Background="{StaticResource DarkBgBrush}">

        <Viewbox Stretch="Uniform">

            <Grid Width="1600"
                  Height="900"
                  Background="{StaticResource DarkBgBrush}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="822"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource HeaderBarStyle}">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnBack"
                                Grid.Column="0"
                                Margin="10,7,0,7"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource BackButton}"
                                ToolTip="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnBack]}"
                                Command="{Binding GoBackCommand}"/>

                        <Image Grid.Column="2"
                               Source="../Assets/Images/logoShort.png"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource ShortLogoStyle}"/>

                    </Grid>

                </Border>
                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="520"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="110"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Margin="65,35,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Settings_lblTitle]}"
                                   Style="{StaticResource PageTitleText}"/>

                        <StackPanel Grid.Row="1"
                                    Margin="100,70,30,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">

                            <Button x:Name="btnAccount"
                                    MinWidth="270"
                                    MinHeight="62"
                                    Margin="0,0,0,55"
                                    Padding="20,12"
                                    HorizontalAlignment="Left"
                                    Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Settings_btnAccount], Mode=OneWay}"
                                    Command="{Binding ShowAccountSectionCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavigationTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAccountSectionVisible}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryRedBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource DarkRedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>

                            </Button>

                            <Button x:Name="btnLanguage"
                                    MinWidth="270"
                                    MinHeight="62"
                                    Margin="0,0,0,55"
                                    Padding="20,12"
                                    HorizontalAlignment="Left"
                                    Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Settings_btnLanguage], Mode=OneWay}"
                                    Command="{Binding ShowLanguageSectionCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavigationTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLanguageSectionVisible}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryRedBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource DarkRedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>

                            </Button>

                            <Button x:Name="btnLogout"
                                    MinWidth="270"
                                    MinHeight="62"
                                    Padding="20,12"
                                    HorizontalAlignment="Left"
                                    Command="{Binding LogoutCommand}"
                                    Style="{StaticResource NavigationTabButton}">

                                <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Settings_btnLogout]}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>

                            </Button>

                        </StackPanel>

                    </Grid>

                    <Border Grid.Column="1"
                            Margin="0,50,0,55"
                            Style="{StaticResource VerticalDividerStyle}"/>

                    <Grid Grid.Column="2">

                        <Grid x:Name="grdAccount"
                              Margin="65,80,75,65"
                              Visibility="{Binding IsAccountSectionVisible, Converter={StaticResource BoolToVis}}">

                            <Grid HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="45"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="85"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*" MinWidth="400"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblPassword]}"
                                           Style="{StaticResource SectionTitleText}"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"/>

                                <Border Grid.Row="0"
                                        Grid.Column="2"
                                        MinWidth="400"
                                        MinHeight="60"
                                        BorderBrush="{StaticResource CreamLightBrush}"
                                        BorderThickness="2"
                                        VerticalAlignment="Center">

                                    <TextBlock x:Name="txbPasswordValue"
                                               Margin="18,0"
                                               Text="************"
                                               Style="{StaticResource TextCream}"
                                               FontSize="12"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <Button x:Name="btnChangePassword"
                                        Grid.Row="0"
                                        Grid.Column="4"
                                        MinWidth="150"
                                        MinHeight="60"
                                        Padding="20,12"
                                        Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Settings_btnChange]}"
                                        Style="{StaticResource PrimaryButton}"
                                        VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_lblEmail]}"
                                           Style="{StaticResource SectionTitleText}"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"/>

                                <TextBox x:Name="txtEmail"
                                         Grid.Row="2"
                                         Grid.Column="2"
                                         MinWidth="400"
                                         MinHeight="60"
                                         Style="{StaticResource CreamTextBox}"
                                         FontSize="12"
                                         VerticalAlignment="Center"/>

                                <Button x:Name="btnChangeEmail"
                                        Grid.Row="2"
                                        Grid.Column="4"
                                        MinWidth="150"
                                        MinHeight="60"
                                        Padding="20,12"
                                        Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Settings_btnChange]}"
                                        Style="{StaticResource PrimaryButton}"
                                        VerticalAlignment="Center"/>

                                <Button x:Name="btnDeleteAccount"
                                        Grid.Row="4"
                                        Grid.Column="2"
                                        MinWidth="270"
                                        MinHeight="58"
                                        Padding="22,12"
                                        HorizontalAlignment="Center"
                                        Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Settings_btnDeleteAccount]}"
                                        Style="{StaticResource OutlineButton}"
                                        FontSize="11"/>

                            </Grid>

                        </Grid>

                        <Grid x:Name="grdLanguage"
                              Margin="65,80,75,65"
                              Visibility="{Binding IsLanguageSectionVisible, Converter={StaticResource BoolToVis}}">

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="btnEnglish"
                                            Grid.Column="0"
                                            MinWidth="240"
                                            MinHeight="62"
                                            Padding="24,12"
                                            Content="ENGLISH"
                                            Tag="en-US"
                                            Command="{Binding SelectLanguageCommand}"
                                            CommandParameter="en-US"
                                            FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                                <Setter Property="Foreground" Value="{StaticResource DisabledGrayBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnglishSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource CreamLightBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button x:Name="btnSpanish"
                                            Grid.Column="2"
                                            MinWidth="240"
                                            MinHeight="62"
                                            Padding="24,12"
                                            Content="ESPAÑOL"
                                            Tag="es-MX"
                                            Command="{Binding SelectLanguageCommand}"
                                            CommandParameter="es-MX"
                                            FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                                <Setter Property="Foreground" Value="{StaticResource DisabledGrayBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSpanishSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource CreamLightBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button x:Name="btnPortuguese"
                                            Grid.Column="4"
                                            MinWidth="240"
                                            MinHeight="62"
                                            Padding="24,12"
                                            Content="PORTUGUÊS"
                                            Tag="pt-BR"
                                            Command="{Binding SelectLanguageCommand}"
                                            CommandParameter="pt-BR"
                                            FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                                <Setter Property="Foreground" Value="{StaticResource DisabledGrayBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPortugueseSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource CreamLightBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                </Grid>

                                <Button x:Name="btnSaveLanguage"
                                        MinWidth="170"
                                        MinHeight="58"
                                        Margin="0,55,0,0"
                                        Padding="24,12"
                                        HorizontalAlignment="Center"
                                        Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnSave]}"
                                        Command="{Binding SaveLanguageCommand}"
                                        Style="{StaticResource OutlineButton}"
                                        FontSize="11"/>

                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Page>