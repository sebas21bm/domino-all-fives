<Page x:Class="DominoAllFives.Client.WPF.Views.JoinGame"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DominoAllFives.Client.WPF.Views"
      xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1600"
      Title="Join Game"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Background="{StaticResource DarkBgBrush}">
        <Viewbox Stretch="Uniform">
            <Grid Width="1600" Height="900" Background="{StaticResource DarkBgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource HeaderBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnBack"
                                Grid.Column="0"
                                Margin="10,7,0,7"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource BackButton}"
                                ToolTip="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnBack]}"
                                Command="{Binding GoBackCommand}"/>

                        <Image Grid.Column="2"
                               Source="../Assets/Images/logoShort.png"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource ShortLogoStyle}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">

                    <Button x:Name="btnSwitchMode" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Top"
                            Width="240" Height="50"
                            Margin="0,25,75,0"
                            Command="{Binding SwitchModeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Content" Value="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[JoinGame_btnInvitations]}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsJoinByCodeMode}" Value="False">
                                        <Setter Property="Content" Value="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[JoinGame_btnJoinByCode]}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="900">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="pnlCodeMode" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsJoinByCodeMode}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[JoinGame_lblRoomCode]}" 
                                       Style="{StaticResource PageTitleText}" 
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,30"/>

                            <TextBox x:Name="txtRoomCode" 
                                     Style="{StaticResource CreamTextBox}" 
                                     Width="400" Height="70" 
                                     FontSize="36" 
                                     MaxLength="6" 
                                     CharacterCasing="Upper" 
                                     TextAlignment="Center"
                                     Text="{Binding RoomCode, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,15"/>

                            <TextBlock Text="{Binding ErrorMessage}" 
                                       Style="{StaticResource ValidationText}" 
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"
                                       Margin="0,0,0,40"/>

                            <Button x:Name="btnJoinRoom"
                                    Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[JoinGame_btnJoinRoom]}"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="400" Height="50"
                                    Command="{Binding JoinRoomCommand}"/>
                        </StackPanel>

                        <Grid x:Name="pnlInvitationsMode">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsJoinByCodeMode}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="350"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[JoinGame_btnInvitations]}" 
                                       Style="{StaticResource PageTitleText}" 
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,30"/>

                            <ListBox x:Name="lstInvitations" 
                                     Grid.Row="1"
                                     ItemsSource="{Binding Invitations}" 
                                     Background="Transparent" 
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalAlignment="Center">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Focusable" Value="False"/>
                                        <Style.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                                        </Style.Resources>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource OutlinedListItemStyle}" Margin="0,0,0,15" Width="700">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Ellipse Grid.Column="0" Style="{StaticResource SmallAvatarBorderStyle}" Margin="0,0,20,0">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding AvatarPath}"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>

                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding Username}" 
                                                           Style="{StaticResource DataValueText}" 
                                                           VerticalAlignment="Center"/>

                                                <Button Grid.Column="2" 
                                                        Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[JoinGame_btnAcceptInvitation]}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Width="220" Height="40"
                                                        Command="{Binding DataContext.AcceptInvitationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Page>
