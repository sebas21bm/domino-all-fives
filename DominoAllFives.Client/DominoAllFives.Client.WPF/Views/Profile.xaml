<Page x:Class="DominoAllFives.Client.WPF.Views.Profile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization"
        mc:Ignorable="d"
        Title="Domino All Fives"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Background="{StaticResource DarkBgBrush}">

        <Viewbox Stretch="Uniform">

            <Grid Width="1600"
                  Height="900"
                  Background="{StaticResource DarkBgBrush}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="822"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource HeaderBarStyle}">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnBack"
                                Grid.Column="0"
                                Margin="10,7,0,7"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource BackButton}"
                                ToolTip="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnBack]}"
                                Command="{Binding GoBackCommand}"/>

                        <Image Grid.Column="2"
                               Source="../Assets/Images/logoShort.png"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource ShortLogoStyle}"/>

                    </Grid>

                </Border>

                <Canvas Grid.Row="1"
                        Width="1600"
                        Height="822"
                        Background="{StaticResource DarkBgBrush}">

                    <TextBlock Canvas.Left="108"
                               Canvas.Top="38"
                               Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Profile_lblTitle]}"
                               Style="{StaticResource PageTitleText}"/>

                    <Ellipse Canvas.Left="617"
                             Canvas.Top="405"
                             Width="330"
                             Height="62"
                             Fill="{StaticResource DarkRedBrush}"
                             Opacity="0.65">

                        <Ellipse.Effect>
                            <DropShadowEffect Color="#CC2222"
                                              BlurRadius="120"
                                              ShadowDepth="0"
                                              Opacity="0.90"/>
                        </Ellipse.Effect>

                    </Ellipse>

                    <Grid Canvas.Left="598"
                          Canvas.Top="69"
                          Width="370"
                          Height="370">

                        <Ellipse Fill="{StaticResource DarkBgBrush}"/>

                        <Image x:Name="imgProfileAvatar"
                               Width="352"
                               Height="352"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="UniformToFill">

                            <Image.Clip>
                                <EllipseGeometry Center="176,176"
                                                 RadiusX="176"
                                                 RadiusY="176"/>
                            </Image.Clip>

                        </Image>

                        <Ellipse Fill="Transparent"
                                 Stroke="{StaticResource CreamLightBrush}"
                                 StrokeThickness="9"
                                 IsHitTestVisible="False"/>

                    </Grid>

                    <Button x:Name="btnEditProfile"
                            Canvas.Left="970"
                            Canvas.Top="448"
                            Width="58"
                            Height="58"
                            Style="{StaticResource IconButton}"
                            ToolTip="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[EditProfile_lblTitle]}"
                            Command="{Binding GoToEditProfileCommand}">

                        <Image Source="../Assets/Icons/iconEdit.png"
                               Style="{StaticResource EditIconStyle}"/>

                    </Button>

                    <TextBlock x:Name="txbUsername"
                               Canvas.Left="548"
                               Canvas.Top="524"
                               Width="470"
                               Height="45"
                               Text="nickname31"
                               Style="{StaticResource TextRed}"
                               FontSize="25"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    
                    <Border Canvas.Left="545"
                            Canvas.Top="600"
                            Width="480"
                            Style="{StaticResource HorizontalDividerStyle}"/>

                    <Grid Canvas.Left="538"
                          Canvas.Top="632"
                          Width="495"
                          Height="155">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="390"/>
                            <ColumnDefinition Width="105"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Profile_lblWins]}"
                                   Style="{StaticResource TextGray}"
                                   FontSize="18"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="txbWins"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Text="10"
                                   Style="{StaticResource DataValueText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Profile_lblTotalPoints]}"
                                   Style="{StaticResource TextGray}"
                                   FontSize="18"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="txbTotalPoints"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   Text="5800"
                                   Style="{StaticResource DataValueText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Profile_lblGamesPlayed]}"
                                   Style="{StaticResource TextGray}"
                                   FontSize="18"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="txbGamesPlayed"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   Text="45"
                                   Style="{StaticResource DataValueText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Grid>

                    <Button x:Name="btnMatchHistory"
                            Canvas.Left="1137"
                            Canvas.Top="622"
                            MinWidth="412"
                            MinHeight="66"
                            Padding="24,16"
                            Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Profile_btnMatchHistory]}"
                            Command="{Binding GoToMatchHistoryCommand}"
                            Style="{StaticResource OutlineButton}"
                            FontSize="17"/>

                </Canvas>

            </Grid>

        </Viewbox>

    </Grid>

</Page>