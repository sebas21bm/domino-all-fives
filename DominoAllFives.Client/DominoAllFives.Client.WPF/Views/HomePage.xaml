<Window x:Class="DominoAllFives.Client.WPF.Views.HomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DominoAllFives.Client.WPF.Views"
        xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization;assembly=DominoAllFives.Client.WPF"
        mc:Ignorable="d"
        Title="HomePage" 
        WindowState="Maximized" 
        WindowStyle="None"
        Background="{StaticResource DarkBgBrush}">

    <Grid>
        <Image Source="/Assets/Images/backgroundDominoPattern.png" 
               Style="{StaticResource BackgroundDominoPatternStyle}"/>

        <Viewbox Stretch="Uniform">
            <Grid Width="1280" Height="720" Margin="40,20">

                <Grid VerticalAlignment="Top">
                    <Button x:Name="btnExitGame"
                            HorizontalAlignment="Left"
                            Style="{StaticResource OutlineButton}"
                            Content="{x:Static loc:Resources.Global_btnExitGame}"
                            MinWidth="200" MinHeight="54"
                            Click="ExitButtonClick"/>
                </Grid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Assets/Images/logoFull.png" 
                           Style="{StaticResource FullLogoStyle}"
                           Width="720" Height="225" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,60"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="btnLogin"
                                Style="{StaticResource PrimaryButton}"
                                Content="{x:Static loc:Resources.Global_btnLogin}"
                                Width="260" MinHeight="60"
                                Margin="0,0,30,0"
                                Click="LoginButtonClick"/>

                        <Button x:Name="btnGuestMode"
                                Style="{StaticResource OutlineButton}"
                                Content="{x:Static loc:Resources.HomePage_btnGuest}"
                                Width="260" MinHeight="60"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Viewbox>

        <Grid x:Name="ModalOverlay" 
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <ContentControl x:Name="ModalContent" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>