<Page x:Class="DominoAllFives.Client.WPF.Views.HomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DominoAllFives.Client.WPF.Views"
        xmlns:loc="clr-namespace:DominoAllFives.Client.WPF.Localization"
        mc:Ignorable="d"
        Title="HomePage" 
        Background="{StaticResource DarkBgBrush}">

    <Grid>
        <Image Source="/Assets/Images/backgroundDominoPattern.png" 
               Style="{StaticResource BackgroundDominoPatternStyle}"/>

        <Viewbox Stretch="Uniform">
            <Grid Width="1280" Height="720" Margin="40,20">

                <Grid VerticalAlignment="Top">
                    <Button x:Name="btnExitGame"
                            HorizontalAlignment="Left"
                            Style="{StaticResource OutlineButton}"
                            Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnExitGame]}"
                            MinWidth="200" MinHeight="54"
                            Command="{Binding ExitGameCommand}"/>
                    <ComboBox x:Name="cbLanguageSelector"
                              HorizontalAlignment="Right"
                              Style="{StaticResource DarkComboBox}"
                              Width="220" MinHeight="54"
                              VerticalContentAlignment="Center"
                              HorizontalContentAlignment="Center"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}">
                        <ComboBoxItem Content="Español (MX)" Tag="es-MX" IsSelected="True"/>
                        <ComboBoxItem Content="English (USA)" Tag="en-US"/>
                        <ComboBoxItem Content="Português (BR)" Tag="pt-BR"/>
                    </ComboBox>
                </Grid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Assets/Images/logoFull.png" 
                           Style="{StaticResource FullLogoStyle}"
                           Width="720" Height="225" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,60"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="btnLogin"
                                Style="{StaticResource PrimaryButton}"
                                Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[Global_btnLogin]}"
                                Width="260" MinHeight="60"
                                Margin="0,0,30,0"
                                Command="{Binding ShowLoginCommand}"/>

                        <Button x:Name="btnGuestMode"
                                Style="{StaticResource OutlineButton}"
                                Content="{Binding Source={x:Static loc:LanguageManager.Instance}, Path=[HomePage_btnGuest]}"
                                Width="260" MinHeight="60"
                                Margin="0,0,30,0"
                                Command="{Binding PlayAsGuestCommand}"/>
                        
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Viewbox>

        <Grid x:Name="ModalOverlay" 
              Visibility="{Binding IsModalVisible, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <ContentControl Content="{Binding CurrentModal}" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>