<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
  <connectionStrings configSource="Configuration\DatabaseConnection.config" />
  <entityFramework><providers><provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" /></providers></entityFramework>
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="DominoTcp" hostNameComparisonMode="Exact" openTimeout="00:00:05" closeTimeout="00:00:05" sendTimeout="00:00:10" receiveTimeout="00:10:00" maxReceivedMessageSize="16777216" maxBufferSize="16777216">
          <readerQuotas maxArrayLength="16777216" maxStringContentLength="8192" />
        </binding>
      </netTcpBinding>
    </bindings>
    <behaviors><serviceBehaviors><behavior name="DominoBehavior"><serviceMetadata httpGetEnabled="true" /><serviceDebug includeExceptionDetailInFaults="false" /></behavior></serviceBehaviors></behaviors>
    <services>
      <service name="DominoAllFives.Server.DominoService" behaviorConfiguration="DominoBehavior">
        <host><baseAddresses>
			<add baseAddress="net.tcp://localhost:8733/Domino" />
			<add baseAddress="http://localhost:8734/Domino/" />
		</baseAddresses></host>
        <endpoint address="" binding="mexHttpBinding" contract="IMetadataExchange" />
        <endpoint address="account" binding="netTcpBinding" bindingConfiguration="DominoTcp" contract="DominoAllFives.Contracts.Wcf.IAuthenticationService" />
      </service>
    </services>
  </system.serviceModel>
</configuration>
